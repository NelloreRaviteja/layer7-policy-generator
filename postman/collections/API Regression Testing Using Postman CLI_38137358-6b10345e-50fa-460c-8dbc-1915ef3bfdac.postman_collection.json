                  "pm.test(\"Error Response Validation\", function () {\r",
                  "    pm.expect(jsonData).to.not.have.property(\"error_code\");\r",
                  "    pm.expect(jsonData).to.not.have.property(\"error_message\");\r",
                  "});"
                ],
