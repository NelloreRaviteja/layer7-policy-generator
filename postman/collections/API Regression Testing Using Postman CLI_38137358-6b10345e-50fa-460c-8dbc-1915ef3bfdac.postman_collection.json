      "name": "API Deployment Readiness Validation",
      "item": [
        {
          "name": "Environment Readiness Validation",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "6b236149-80c4-45e3-a1f9-b722173827fd",
                "exec": [
                  "let jsonData = pm.response.json();\r",
                  "\r",
                  "// 1. HTTP Method Validation\r",
                  "pm.test(\"HTTP Method Validation\", function () {\r",
                  "    pm.expect(pm.request.method).to.eql(\"POST\");\r",
                  "});\r",
                  "\r",
                  "// 2. Content-Type Validation\r",
                  "pm.test(\"Content-Type Validation\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// 3. Response Time Validation\r",
                  "pm.test(\"Response Time Validation\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "// 4. Status Code Validation\r",
                  "pm.test(\"Status Code Validation\", function () {\r",
                  "    pm.expect(pm.response.code).to.eql(200);\r",
                  "});\r",
                  "\r",
                  "// 5. API Deployment Readiness Validation\r",
                  "pm.test(\"API Deployment Readiness Validation\", function () {\r",
                  "    pm.expect(jsonData.status).to.eql(\"SUCCESS\");\r",
                  "    pm.expect(jsonData.deployment_status).to.eql(\"READY_FOR_PROMOTION\");\r",
                  "});\r",
                  "\r",
                  "// 6. Response Body Validation\r",
                  "pm.test(\"Response Body Validation\", function () {\r",
                  "    pm.expect(jsonData).to.have.property(\"request_id\");\r",
                  "    pm.expect(jsonData).to.have.property(\"api_name\");\r",
                  "    pm.expect(jsonData).to.have.property(\"current_environment\");\r",
                  "    pm.expect(jsonData).to.have.property(\"next_environment\");\r",
                  "});\r",
                  "\r",
                  "// 7. Request ID Validation\r",
                  "pm.test(\"Request ID Validation\", function () {\r",
                  "    pm.expect(jsonData.request_id).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "// 8. API Name Validation\r",
                  "pm.test(\"API Name Validation\", function () {\r",
                  "    pm.expect(jsonData.api_name).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "// 9. Deployment Status Validation\r",
                  "pm.test(\"Deployment Status Validation\", function () {\r",
                  "    pm.expect(jsonData.deployment_status).to.eql(\"READY_FOR_PROMOTION\");\r",
                  "});\r",
                  "\r",
                  "// 10. Validation Result\r",
                  "pm.test(\"Validation Result\", function () {\r",
                  "    pm.expect(jsonData.validation_result).to.eql(\"PASS\");\r",
                  "});\r",
                  "\r",
