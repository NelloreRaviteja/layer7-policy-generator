  "item": [
    {
      "name": "Customer Fund Transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "38c2bcf1-891a-4a48-a9d9-07acb84a58f8",
            "exec": [
              "var response = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "\r",
              "    pm.test(\"Status code is 200\", function () {\r",
              "        pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Status should be SUCCESS\", function () {\r",
              "        pm.expect(response.status).to.eql(\"SUCCESS\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Transaction Status\", function () {\r",
              "        pm.expect(response.transaction_status).to.eql(\"SUCCESS\");\r",
              "    });\r",
              "\r",
              "}\r",
              "else if (pm.response.code === 400) {\r",
              "\r",
              "    pm.test(\"Status code is 400\", function () {\r",
              "        pm.response.to.have.status(400);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Status should be FAILURE\", function () {\r",
              "        pm.expect(response.status).to.eql(\"FAILURE\");\r",
              "    });\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
