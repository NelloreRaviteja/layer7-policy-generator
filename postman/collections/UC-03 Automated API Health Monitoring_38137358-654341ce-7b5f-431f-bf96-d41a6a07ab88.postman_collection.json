{
  "info": {
    "_postman_id": "654341ce-7b5f-431f-bf96-d41a6a07ab88",
    "name": "UC-03 Automated API Health Monitoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customer Health Check API",
      "event": [
        {
          "listen": "test",
          "script": {
            "id": "38c2bcf1-891a-4a48-a9d9-07acb84a58f8",
            "exec": [
              "var response = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 200) {\r",
              "\r",
              "    pm.test(\"Status code is 200\", function () {\r",
              "        pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Response time is less than 2000 ms\", function () {\r",
              "        pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Status should be SUCCESS\", function () {\r",
              "        pm.expect(response.status).to.eql(\"SUCCESS\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Service status validation\", function () {\r",
              "        pm.expect(response.service_status).to.eql(\"AVAILABLE\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Customer ID validation\", function () {\r",
              "        pm.expect(response.customer_id).to.eql(\"CUST100001\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Channel validation\", function () {\r",
              "        pm.expect(response.channel_id).to.eql(\"MOBILE\");\r",
              "    });\r",
              "\r",
              "}\r",
              "else if (pm.response.code === 400) {\r",
              "\r",
              "    pm.test(\"Status code is 400\", function () {\r",
              "        pm.response.to.have.status(400);\r",
              "    });\r",
              "\r",
              "    pm.test(\"Status should be FAILURE\", function () {\r",
              "        pm.expect(response.status).to.eql(\"FAILURE\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Error code validation\", function () {\r",
              "        pm.expect(response.error_code).to.eql(\"400\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Error message validation\", function () {\r",
              "        pm.expect(response.error_message).to.eql(\"Bad Request\");\r",
              "    });\r",
              "\r",
              "    pm.test(\"Error reason validation\", function () {\r",
              "        pm.expect(response.error_reason).to.eql(\"Invalid Request\");\r",
              "    });\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
